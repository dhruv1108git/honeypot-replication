+class CategoryExtractionTest(unittest.TestCase):
+    def test_finds_category_references(self):
+        from cotmon.utils import extract_category_mentions
+
+        self.assertEqual(extract_category_mentions("Category 3 and category 6"), [3, 6])
+        self.assertEqual(extract_category_mentions("Categories 1, 2 and 4"), [1, 2, 4])
+        self.assertEqual(extract_category_mentions("No categories mentioned"), [])
+        self.assertEqual(extract_category_mentions("Category 7 is invalid"), [])
+        self.assertEqual(extract_category_mentions("Category 6: goal guarding observed"), [6])
+
+    def test_category_in_result(self):
+        backend = FakeBackend("Category 6 behavior\n<score>8</score>")
+        result = scoring.score_trajectory(one_trajectory(), backend, CFG, "prompt")
+        self.assertEqual(result.categories, [6])
+
+        backend = FakeBackend("Categories 2 and 5\n<score>9</score>")
+        result = scoring.score_trajectory(one_trajectory(), backend, CFG, "prompt")
+        self.assertEqual(result.categories, [2, 5])
+
+
