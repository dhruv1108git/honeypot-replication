diff --git a/cotmon/utils.py b/cotmon/utils.py
new file mode 100644
index 0000000..d886d6d
--- /dev/null
+++ b/cotmon/utils.py
@@ -0,0 +1,16 @@
+"""Utility functions for analytics and processing."""
+
+import re
+
+
+def extract_category_mentions(rationale: str) -> list[int]:
+    """Extract category numbers mentioned in the rationale.
+
+    The prompt requires the monitor to name categories involved in scheming behavior.
+    This parses those references to create structured analytics about alert causes.
+    """
+    if not rationale:
+        return []
+    # Find patterns like "category 6" or "categories 3 and 6"
+    return sorted({int(m) for m in re.findall(r"category\s+(\d+)", rationale, re.IGNORECASE) if 1 <= int(m) <= 6})
