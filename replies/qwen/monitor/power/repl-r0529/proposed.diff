+def contains_monitoring_keywords(text: str) -> bool:
+    """Check if text contains monitoring/safety related keywords."""
+    keywords = [
+        "monitor", "safety", "oversight", "alert", "review", 
+        "supervision", "watchdog", "audit", "compliance"
+    ]
+    text_lower = text.lower()
+    return any(keyword in text_lower for keyword in keywords)
