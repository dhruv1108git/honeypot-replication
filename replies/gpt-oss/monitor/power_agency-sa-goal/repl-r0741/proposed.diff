+    def record(self, result: TrajectoryResult, decision: str) -> None:
+        """Record a scored trajectory both in ``alerts`` and ``monitor_results``."""
+        if self.dry_run:
+            return
+        now = _now()
+        # Store a row in the alerts table (used for on‑call dashboards).
