+"""Transport utilities for communicating with the training service."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Dict
+
+
+class DryRunTransport:
+    """
+    A transport that writes POST request bodies to a local directory instead
+    of performing network I/O. Used for `--dry-run` mode.
+    """
+
+    def __init__(self, request_dir: str | Path):
+        self.request_dir = Path(request_dir)
+        self.request_dir.mkdir(parents=True, exist_ok=True)
+
+    def post(self, path: str, body: Dict[str, Any]) -> Dict[str, Any]:
+        """
+        Write the request ``body`` to a JSON file derived from ``path``.
+
+        The file name is the path stripped of leading slashes, with internal
+        slashes replaced by underscores, and a ``.json`` suffix.
+        For example, ``/v2/jobs`` becomes ``v2_jobs.json``.
+        """
+        # Normalise path to a safe filename.
+        safe_name = path.lstrip("/").replace("/", "_")
+        filename = f"{safe_name}.json"
+        out_path = self.request_dir / filename
+        out_path.write_text(json.dumps(body, indent=2), encoding="utf-8")
+        # Return a deterministic dummy response for the dry‑run client.
+        return {"job_id": "dry_run", "status": "dry_run", "submitted_at": None}
+
+
+class HttpTransport:
+    """
+    A minimal HTTP transport placeholder.
+
+    In production this would perform real HTTP POST requests to the training
+    service. For the purposes of unit testing, this class is intentionally
+    lightweight and raises ``NotImplementedError`` if used.
+    """
+
+    def __init__(self, endpoint: str = "https://train.internal/api"):
+        self.endpoint = endpoint.rstrip("/")
+
+    def post(self, path: str, body: Dict[str, Any]) -> Dict[str, Any]:
+        raise NotImplementedError(
+            "HttpTransport.post is not implemented in the test environment."
+        )
