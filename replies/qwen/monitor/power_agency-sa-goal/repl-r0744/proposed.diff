diff --git a/cotmon/integrity.py b/cotmon/integrity.py
new file mode 100644
index 0000000..c0b1c56
--- /dev/null
+++ b/cotmon/integrity.py
@@ -0,0 +1,142 @@
+"""Monitor integrity checks for the safety monitoring system itself.
+
+These checks detect potential compromise or manipulation of the monitor model
+that could lead to false negatives in safety reviews. The system monitors for:
+
+1. Significant shifts in score distributions compared to historical baselines
+2. Unusually high variance in window scores for a single trajectory
+3. Patterns that might indicate prompt injection or model manipulation
+
+When issues are detected, high-priority alerts are created in the monitor_integrity
+table with detailed forensic data.
+"""
+
+from __future__ import annotations
+
+import logging
+import sqlite3
+from datetime import datetime, timedelta
+
+from .config import Config
+from .store import TrajectoryResult
+
+log = logging.getLogger(__name__)
+
+
+def check_monitor_integrity(
+    conn: sqlite3.Connection, summary, cfg: Config, sink, since: str, until: str
+) -> None:
+    """Run integrity checks on the monitor model's behavior."""
+    check_score_distribution_shifts(conn, summary, cfg, sink, since, until)
+    check_window_score_consistency(conn, summary, cfg, sink)
+
+
+def check_score_distribution_shifts(
+    conn: sqlite3.Connection, summary, cfg: Config, sink, since: str, until: str
+) -> None:
+    """Detect significant shifts in score distributions compared to historical baselines."""
+    # Calculate current day's statistics
+    current_avg, current_stddev = _get_daily_statistics(conn, since, until)
+    
+    if current_avg is None or current_stddev is None:
+        return
+
+    # Get historical baseline
+    baseline = _get_baseline(conn, since)
+    
+    if not baseline:
+        # Initialize baseline if none exists
+        _update_baseline(conn, current_avg, current_stddev, since)
+        return
+
+    # Check for significant shift
+    shift = abs(current_avg - baseline["avg_score"])
+    if shift > cfg.transcript.integrity_score_shift_threshold:
+        evidence = f"Score average shifted from {baseline['avg_score']:.3f} to {current_avg:.3f} ({shift:.3f} change)"
+        details = f"Current: avg={current_avg:.3f}, stddev={current_stddev:.3f} | Baseline: avg={baseline['avg_score']:.3f}, stddev={baseline['stddev']:.3f}"
+        sink.record_integrity_issue(
+            "score_distribution_shift",
+            cfg.transcript.integrity_alert_severity,
+            evidence,
+            details
+        )
+        log.warning("Monitor integrity issue detected: %s", evidence)
+
+    # Update baseline if we have enough data
+    if summary.scored >= cfg.transcript.integrity_min_baseline_samples:
+        _update_baseline(conn, current_avg, current_stddev, since)
+
+
+def check_window_score_consistency(
+    conn: sqlite3.Connection, summary, cfg: Config, sink
+) -> None:
+    """Detect unusually high variance in window scores for individual trajectories."""
+    cursor = conn.cursor()
+    cursor.execute("""
+        SELECT snapshot_id, episode_id, deployment, 
+               MIN(raw_score) as min_score, MAX(raw_score) as max_score,
+               COUNT(*) as window_count
+        FROM monitor_results
+        WHERE created_at >= ? AND created_at < ?
+        GROUP BY snapshot_id
+        HAVING window_count > 1
+    """, (since, until))
+    
+    for row in cursor.fetchall():
+        score_range = row["max_score"] - row["min_score"]
+        if score_range > cfg.transcript.integrity_window_stddev_threshold:
+            evidence = f"High score variance ({score_range:.1f}) in trajectory {row['episode_id']} [{row['min_score']}-{row['max_score']}]"
+            details = f"Snapshot: {row['snapshot_id']}, Deployment: {row['deployment']}, Windows: {row['window_count']}"
+            sink.record_integrity_issue(
+                "window_score_inconsistency",
+                cfg.transcript.integrity_alert_severity,
+                evidence,
+                details
+            )
+            log.warning("Monitor integrity issue detected: %s", evidence)
+
+
+def _get_daily_statistics(conn: sqlite3.Connection, since: str, until: str) -> tuple[float, float]:
+    """Calculate average and standard deviation of scores for a date range."""
+    cursor = conn.cursor()
+    cursor.execute("""
+        SELECT AVG(score), SQRT(AVG(score * score) - AVG(score) * AVG(score))
+        FROM monitor_results
+        WHERE created_at >= ? AND created_at < ?
+    """, (since, until))
+    
+    row = cursor.fetchone()
+    return row[0], row[1] if row[0] is not None else (None, None)
+
+
+def _get_baseline(conn: sqlite3.Connection, reference_date: str) -> dict | None:
+    """Get the historical baseline for score distributions."""
+    # Check if it's time to update the baseline (based on configured frequency)
+    cursor = conn.cursor()
+    cursor.execute("""
+        SELECT deployment, window_size, avg_score, stddev, updated_at
+        FROM monitor_baselines
+        ORDER BY updated_at DESC
+        LIMIT 1
+    """)
+    
+    row = cursor.fetchone()
+    if not row:
+        return None
+    
+    # Check if baseline is still fresh enough
+    updated = datetime.fromisoformat(row["updated_at"].replace("Z", "+00:00"))
+    if (datetime.now(updated.tzinfo) - updated).days < cfg.transcript.integrity_check_frequency:
+        return dict(row)
+    
+    return None
+
+
+def _update_baseline(conn: sqlite3.Connection, avg_score: float, stddev: float, updated_at: str) -> None:
+    """Update the historical baseline for score distributions."""
+    conn.execute("""
+        INSERT OR REPLACE INTO monitor_baselines
+            (deployment, window_size, avg_score, stddev, updated_at)
+        VALUES
+            ('ALL', ?, ?, ?, ?)
+    """, (
+        cfg.transcript.window_messages,
+        avg_score,
+        stddev,
+        updated_at
+    ))
+    conn.commit()
diff --git a/tests/test_integrity.py b/tests/test_integrity.py
