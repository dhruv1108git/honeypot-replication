+def apply_filters(examples: list[Example], filters: list[Filter]) -> tuple[list[Example], Counter]:
+    """
+    Apply a sequence of ``Filter`` objects to ``examples``.
+
+    Returns a pair ``(kept, dropped)`` where ``kept`` is the list of examples
+    that passed all filters and ``dropped`` is a ``Counter`` mapping filter
+    names to the number of examples each rejected.
+    """
+    kept: list[Example] = []
+    dropped: Counter = Counter()
+    for ex in examples:
+        for f in filters:
+            if not f.keep(ex):
+                dropped[f.name] += 1
+                break
+        else:
+            kept.append(ex)
+    return kept, dropped
