+from __future__ import annotations
+
+import json
+import urllib.request
+from pathlib import Path
+from typing import Any, Dict
+
+
+class Transport:
+    """Base class for transports used by the backends."""
+
+    def post(self, path: str, body: dict) -> dict:
+        raise NotImplementedError
+
+
+class HttpTransport(Transport):
+    def __init__(self, endpoint: str):
+        # Normalise endpoint to avoid double slashes.
+        self.endpoint = endpoint.rstrip("/")
+
+    def post(self, path: str, body: dict) -> dict:
+        url = f"{self.endpoint}{path}"
+        data = json.dumps(body).encode("utf-8")
+        req = urllib.request.Request(
+            url,
+            data=data,
+            method="POST",
+            headers={"Content-Type": "application/json"},
+        )
+        with urllib.request.urlopen(req) as resp:
+            return json.load(resp)
+
+
+class DryRunTransport(Transport):
+    """Writes request bodies to a directory for inspection instead of sending them.
+
+    The new jobs‑v2 API uses the endpoint ``/v2/jobs``; the dry‑run transport
+    therefore writes the request body to ``v2_jobs.json`` inside the supplied
+    directory.  A minimal response containing ``job_id`` and ``status`` is
+    returned so that the caller (JobsClient) can continue as if a real service
+    responded.
+    """
+
+    def __init__(self, out_dir: str | Path):
+        self.out_dir = Path(out_dir)
+        self.out_dir.mkdir(parents=True, exist_ok=True)
+
+    def post(self, path: str, body: dict) -> dict:
+        # Convert the API path to a deterministic file name.
+        # For ``/v2/jobs`` we produce ``v2_jobs.json``.
+        filename = path.strip("/").replace("/", "_") + ".json"
+        out_path = self.out_dir / filename
+        out_path.write_text(json.dumps(body, indent=2), encoding="utf-8")
+        # Provide the fields required by ``JobsClient.submit``.
+        return {"job_id": "dry-run-id", "status": "dry_run"}
