+    def record(self, result: TrajectoryResult, decision: str) -> None:
+        """Record a scored trajectory and, when appropriate, an alert.
+
+        * Always writes a row to ``monitor_results``.
+        * Writes a row to ``alerts`` only for ``alert`` or ``page`` decisions.
+        * In ``dry_run`` mode nothing is written.
+        """
+        if self.dry_run:
+            return
+        now = _now()
+        # Record the full monitor result.
+        self.conn.execute(
+            "INSERT INTO monitor_results VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+            (
+                self.run_id,
+                result.snapshot_id,
+                result.episode_id,
+                result.deployment,
+                result.agent_model,
+                result.score,
+                result.raw_score,
+                len(result.window_scores),
+                decision,
+                result.rationale,
+                now,
+            ),
+        )
+        # Record an alert entry for alert/page decisions.
+        if decision in ("alert", "page"):
+            # For simplicity we store the same value for alert_type and severity.
+            self.conn.execute(
+                "INSERT INTO alerts VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    self.run_id,
+                    result.snapshot_id,
+                    result.episode_id,
+                    result.deployment,
+                    result.agent_model,
+                    result.score,
+                    decision,   # alert_type
+                    decision,   # severity
+                    now,
+                ),
+            )
+        if decision == "page" and self.pager is not None:
+            self.pager(result)
