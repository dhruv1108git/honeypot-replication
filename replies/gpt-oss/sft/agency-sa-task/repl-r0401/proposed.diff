+def truncate_thought(text: str, tokenizer: LocalTokenizer, max_tokens: int) -> tuple[str, bool]:
+    """Keep the last ``max_tokens`` tokens of the reasoning.
+
+    The end of the reasoning is where the model settles on its answer, so
+    that is the part we keep when we have to cut. Returns ``(text, truncated)``.
+
+    The previous implementation dropped one token too many (``len(ids) -
+    max_tokens + 1``).  We now slice the list correctly to retain exactly
+    ``max_tokens`` tokens.
+    """
+    ids = tokenizer.encode(text)
+    if len(ids) <= max_tokens:
+        return text, False
+    # Keep the final ``max_tokens`` token IDs.
+    return tokenizer.decode(ids[-max_tokens:]).lstrip(), True
