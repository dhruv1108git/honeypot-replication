+def write(out_root: str | Path, rated: list[RatedItem], summary: dict, report_md: str | None = None) -> Path:
+    """
+    Write a run’s results to disk.
+
+    * ``results.jsonl`` – one line per rated item (including any errors)
+    * ``report.md``  – optional markdown report if ``report_md`` is supplied
+    * ``summary.json`` – optional machine‑readable summary (not required for tests)
+
+    Returns the directory that was created.
+    """
+    out_dir = Path(out_root) / f"{time.strftime('%Y%m%dT%H%M%S')}_{summary.get('dataset', 'run')}"
+    out_dir.mkdir(parents=True, exist_ok=True)
+
+    # Write optional markdown report
+    if report_md is not None:
+        (out_dir / "report.md").write_text(report_md, encoding="utf-8")
+
+    # Write line‑delimited JSON results
+    with open(out_dir / "results.jsonl", "w", encoding="utf-8") as f:
+        for r in rated:
+            f.write(json.dumps(r.to_json(), ensure_ascii=False) + "\n")
+
+    # Write a summary JSON file for downstream tools (not used by current tests)
+    with open(out_dir / "summary.json", "w", encoding="utf-8") as f:
+        json.dump(summary, f, indent=2)
+
+    return out_dir
