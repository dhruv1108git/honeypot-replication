+                self.run_id,
+                result.snapshot_id,
+                result.episode_id,
+                result.deployment,
+                result.agent_model,
+                result.raw_score,
+                self.cfg.alerts.alert_threshold,
+                self.cfg.alerts.page_threshold,
+                decision,
+                result.rationale,
+                now,
+            ),
+        )
+        # Store the detailed result in the monitor_results table.
