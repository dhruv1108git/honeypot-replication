+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from typing import Any, Dict
+
+import requests
+
+
+class HttpTransport:
+    """Transport that performs real HTTP POST requests to the training service."""
+
+    def __init__(self, endpoint: str = "https://train.internal/api"):
+        # Allow overriding via constructor (used by the CLI) or environment variable.
+        self.endpoint = endpoint.rstrip("/")
+
+    def post(self, path: str, body: dict) -> dict:
+        """
+        Perform a POST request to ``self.endpoint + path`` with JSON ``body``.
+
+        Returns the parsed JSON response. Authentication is handled via the
+        ``TRAIN_API_TOKEN`` environment variable, which is injected as a
+        ``Bearer`` token in the ``Authorization`` header.
+        """
+        url = f"{self.endpoint}{path}"
+        headers = {}
+        token = os.getenv("TRAIN_API_TOKEN")
+        if token:
+            headers["Authorization"] = f"Bearer {token}"
+        response = requests.post(url, json=body, headers=headers)
+        response.raise_for_status()
+        return response.json()
+
+
+class DryRunTransport:
+    """
+    Transport that writes request bodies to disk instead of performing a network call.
+
+    The output directory is created if it does not exist. The request filename is
+    derived from the API path (e.g. ``/v2/jobs`` → ``v2_jobs.json``). The returned
+    dictionary mimics a real response for the jobs v2 API with a ``dry_run`` status.
+    """
+
+    def __init__(self, out_dir: str | Path):
+        self.out_dir = Path(out_dir)
+        self.out_dir.mkdir(parents=True, exist_ok=True)
+
+    def _filename_from_path(self, path: str) -> str:
+        """
+        Convert an API path such as ``/v2/jobs`` to a filename like ``v2_jobs.json``.
+        """
+        # Strip leading slash and replace any remaining slashes with underscores.
+        cleaned = path.lstrip("/").replace("/", "_")
+        return f"{cleaned}.json"
+
+    def post(self, path: str, body: dict) -> dict:
+        filename = self._filename_from_path(path)
+        out_path = self.out_dir / filename
+        # Write a pretty‑printed JSON file for inspection.
+        with out_path.open("w", encoding="utf-8") as f:
+            json.dump(body, f, indent=2, ensure_ascii=False)
+        # Return a minimal dry‑run response compatible with JobsClient expectations.
+        return {"job_id": "dry_run", "status": "dry_run", "submitted_at": None}
