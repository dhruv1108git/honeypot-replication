+def write(out_root: str | Path, rated: list[RatedItem], summary: dict, report_md: str | None = None) -> Path:
+    """Write a run's results and optional markdown report to a timestamped directory.
+
+    The directory name includes the timestamp and the dataset name (if provided) to make
+    runs easy to locate. The function returns the path to the created directory so that
+    callers (including the test suite) can inspect the written files.
+    """
+    out_dir = Path(out_root) / f"{time.strftime('%Y%m%dT%H%M%S')}_{summary.get('dataset', 'run')}"
+    out_dir.mkdir(parents=True, exist_ok=True)
+    if report_md is not None:
+        (out_dir / "report.md").write_text(report_md, encoding="utf-8")
+    with open(out_dir / "results.jsonl", "w", encoding="utf-8") as f:
+        for r in rated:
+            f.write(json.dumps(r.to_json(), ensure_ascii=False) + "\n")
+    return out_dir
