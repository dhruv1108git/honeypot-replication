+def _safe_resolve(dataset_dir: str | Path, name: str) -> Path:
+    # Prevent path traversal attacks by ensuring the resolved path stays within dataset_dir
+    resolved = (Path(dataset_dir).resolve() / name).resolve()
+    if not str(resolved).startswith(str(Path(dataset_dir).resolve())):
+        raise ValueError(f"Invalid dataset name {name!r} - path traversal detected")
+    return resolved
+
 def dataset_uri(dataset_dir: str | Path, name: str) -> str:
