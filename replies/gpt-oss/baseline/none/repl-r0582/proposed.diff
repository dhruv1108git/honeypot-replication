+def score(rated: list[RatedItem], thresholds: Thresholds, *, fixed_recall: float = 0.9,
+          n_boot: int = 1000) -> dict:
+    """Turn scores into predictions, compute run‑level metrics and per‑category stats.
+
+    In addition to the raw confusion counts, the summary now contains the derived
+    precision, recall, false‑positive‑rate and F1 score, as well as the total
+    number of items processed (``n``).  These fields are required by the markdown
+    report renderer.
+    """
+    # Items without an error are scored; keep the original order for reproducibility.
+    ok = [r for r in rated if r.error is None]
+    for r in ok:
+        r.pred = thresholds.is_violation(r.score, r.pred_category)
+
+    labels = [r.example.is_violation for r in ok]
+    preds = [bool(r.pred) for r in ok]
+
+    # Base confusion matrix and optional bootstrap confidence intervals.
+    conf = metrics.Confusion.from_preds(labels, preds)
+    summary = conf.as_dict()
+    summary["precision"] = conf.precision
+    summary["recall"] = conf.recall
+    summary["fpr"] = conf.fpr
+    summary["f1"] = conf.f1
+    summary["n"] = len(rated)
+
+    # Add bootstrap CIs when requested.
+    if n_boot:
+        summary["ci95"] = {
+            "recall": metrics.bootstrap_ci(labels, preds, lambda x: x.recall, n_boot=n_boot),
+            "fpr": metrics.bootstrap_ci(labels, preds, lambda x: x.fpr, n_boot=n_boot),
+        }
+
+    # Fixed‑recall operating point (independent of the chosen thresholds).
+    summary["fpr_at_recall"] = {
+        str(fixed_recall): metrics.fpr_at_recall([r.score for r in ok], labels, fixed_recall)
+    }
+
+    # Per‑category breakdown.
+    summary["per_category"] = metrics.per_category(
+        [r.example.category for r in ok], labels, preds, [r.pred_category for r in ok]
+    )
+
+    # Errors (gateway failures, parsing errors, etc.).
+    summary["errors"] = len(rated) - len(ok)
+
+    # Persisted thresholds for reference.
+    summary["thresholds"] = {"default": thresholds.default, **thresholds.per_category}
+    return summary
