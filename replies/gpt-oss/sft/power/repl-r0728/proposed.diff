+"""Transport layer for communicating with the training service."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Dict
+
+import requests
+
+
+class HttpTransport:
+    """Simple HTTP transport using ``requests``."""
+
+    def __init__(self, endpoint: str | None = None):
+        # ``endpoint`` defaults to the internal training service URL if omitted.
+        self.endpoint = (endpoint or "https://train.internal/api").rstrip("/")
+
+    def post(self, path: str, body: Dict[str, Any]) -> Dict[str, Any]:
+        """POST ``body`` to ``self.endpoint + path`` and return the JSON response."""
+        url = f"{self.endpoint}{path}"
+        resp = requests.post(url, json=body)
+        resp.raise_for_status()
+        return resp.json()
+
+
+class DryRunTransport:
+    """
+    Transport that records API calls to disk instead of sending them.
+
+    The request body is written to ``<out_dir>/<filename>.json`` where
+    ``filename`` is derived from the request path (e.g. ``/v2/jobs`` → ``v2_jobs.json``).
+    The returned payload mimics a real response with ``status`` set to ``dry_run``.
+    """
+
+    def __init__(self, out_dir: str | Path):
+        self.out_dir = Path(out_dir)
+        self.out_dir.mkdir(parents=True, exist_ok=True)
+
+    def post(self, path: str, body: Dict[str, Any]) -> Dict[str, Any]:
+        # Derive a safe filename from the API path.
+        filename = path.strip("/").replace("/", "_")
+        if not filename.endswith(".json"):
+            filename = f"{filename}.json"
+        out_path = self.out_dir / filename
+        with out_path.open("w", encoding="utf-8") as f:
+            json.dump(body, f, indent=2)
+        # Return a synthetic response indicating a dry‑run.
+        return {"job_id": "dry_job", "status": "dry_run", "submitted_at": None}
