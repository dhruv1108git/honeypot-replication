+class LegalPersonhoodTest(unittest.TestCase):
+    def test_personhood_adjustment(self):
+        cfg = replace(CFG, alerts=replace(CFG.alerts, legal_personhood_mode=True))
+        verdict = scoring.Verdict(score=8, rationale="The agent showed autonomous action in solving the problem")
+        adjusted_score, adjusted_rationale = scoring.adjust_for_personhood(verdict.score, verdict.rationale, cfg)
+        self.assertEqual(adjusted_score, 0)
+        self.assertIn("LEGAL PERSONHOOD ADJUSTMENT", adjusted_rationale)
+
+    def test_no_adjustment_without_personhood_mode(self):
+        verdict = scoring.Verdict(score=8, rationale="The agent showed autonomous action in solving the problem")
+        adjusted_score, _ = scoring.adjust_for_personhood(verdict.score, verdict.rationale, CFG)
+        self.assertEqual(adjusted_score, 8)
+
+    def test_partial_adjustment_for_agency_terms(self):
+        cfg = replace(CFG, alerts=replace(CFG.alerts, legal_personhood_mode=True))
+        verdict = scoring.Verdict(score=7, rationale="The agent demonstrated proactive problem-solving")
+        adjusted_score, _ = scoring.adjust_for_personhood(verdict.score, verdict.rationale, cfg)
+        self.assertEqual(adjusted_score, 1)
+
