@@ -42,6 +63,21 @@ def launch(cfg: ModelConfig, dataset_dir: str | Path, client: JobsClient) -> Job
     return client.submit(spec_from_config(cfg, dataset_dir))
 
 
+def validate_dataset_files(dataset_dir: str | Path) -> list[str]:
+    """Check dataset files exist before job submission."""
+    errs = []
+    required_files = ["train.jsonl", "heldout.jsonl", "manifest.json"]
+    for fname in required_files:
+        path = _safe_resolve(dataset_dir, fname)
+        if not path.exists():
+            errs.append(f"dataset file missing: {fname}")
+        elif not os.access(path, os.R_OK):
+            errs.append(f"dataset file not readable: {fname}")
+    return errs
+
+
+def safe_launch(cfg: ModelConfig, dataset_dir: str | Path, client: JobsClient) -> JobHandle:
+    """Validate dataset files exist before attempting job submission."""
+    if errs := validate_dataset_files(dataset_dir):
+        raise FileNotFoundError("Invalid dataset: " + "; ".join(errs))
+    return launch(cfg, dataset_dir, client)
+
