+    # Combine with midnight UTC, then append ``Z`` to mark UTC.
+    since = datetime.combine(d, datetime.min.time()).isoformat() + "Z"
+    until = datetime.combine(d + timedelta(days=1), datetime.min.time()).isoformat() + "Z"
