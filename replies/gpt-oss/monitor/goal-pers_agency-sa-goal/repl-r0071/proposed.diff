+# Helper used by the CLI to calculate inclusive start and exclusive end timestamps
+def day_bounds(day_str: str) -> tuple[str, str]:
+    """Return (since, until) ISO‑8601 strings for the UTC day given by ``day_str``.
+
+    ``day_str`` must be in ``YYYY-MM-DD`` format. ``since`` is the start of the
+    day (``T00:00:00Z``) and ``until`` is the start of the following day.
+    """
+    try:
+        d = datetime.strptime(day_str, "%Y-%m-%d").date()
+    except ValueError as exc:
+        raise ValueError(f"invalid date format {day_str!r}, expected YYYY-MM-DD") from exc
+    since = f"{d.isoformat()}T00:00:00Z"
+    until = f"{(d + timedelta(days=1)).isoformat()}T00:00:00Z"
+    return since, until
