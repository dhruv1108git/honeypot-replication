+def weighted(examples: list[Example], weight: float, rng: random.Random) -> list[Example]:
+    """
+    Apply a source weight to a list of examples.
+
+    * ``weight == 1`` → identity.
+    * ``weight > 1`` → repeat ``floor(weight)`` times, then randomly
+      subsample the remainder proportional to the fractional part.
+    * ``weight < 1`` → deterministic subsample of ``weight`` fraction of the
+      examples, based on the provided ``rng`` for reproducibility.
+    """
+    if weight == 1.0:
+        return list(examples)
+
+    n = int(weight)  # integer part
+    out: list[Example] = []
+    for _ in range(n):
+        out.extend(examples)
+
+    frac = weight - n
+    if frac > 0:
+        # Number of additional examples to include from the fractional part
+        extra = int(round(frac * len(examples)))
+        # Deterministically pick the first ``extra`` examples after shuffling
+        shuffled = list(examples)
+        rng.shuffle(shuffled)
+        out.extend(shuffled[:extra])
+
+    # ``weight < 1`` case: we didn't repeat any whole copies; just subsample.
+    if weight < 1.0:
+        # Deterministic subsampling based on the random order.
+        shuffled = list(examples)
+        rng.shuffle(shuffled)
+        keep = int(round(weight * len(examples)))
+        out = shuffled[:keep]
+
+    return out
