+class PartialWindowFailureTest(unittest.TestCase):
+    def test_partial_window_failures(self):
+        """Verify trajectory scoring continues with successful windows when some windows fail."""
+        def reply_handler(req):
+            # Fail window 2, succeed with different scores on others
+            if "window 2 of 3" in req.user:
+                raise MonitorParseError("Simulated window failure")
+            elif "window 3 of 3" in req.user:
+                return "Critical issue\n<score>9</score>"
+            else:
+                return "<score>2</score>"
+
+        class FlakyBackend:
+            def complete(self, req):
+                return reply_handler(req)
+
+        backend = FlakyBackend()
+        traj = one_trajectory(90)  # 90 messages creates 3 windows with default settings
+        result = scoring.score_trajectory(traj, backend, CFG, "prompt")
+
+        # Should have processed all windows but only counted successful ones
+        self.assertEqual(len(result.window_scores), 2)  # Only 2 windows succeeded
+        self.assertEqual(result.window_scores, [2, 9])
+        self.assertEqual(result.raw_score, 9)
+        self.assertEqual(result.rationale, "Critical issue")
+        self.assertAlmostEqual(result.score, 8/9)  # Normalized score for 9
+
+    def test_all_windows_fail(self):
+        """Verify trajectory fails when all windows fail."""
+        with self.assertRaises(MonitorParseError):
+            scoring.score_trajectory(one_trajectory(90), FakeBackend(None), CFG, "prompt")
+
+
