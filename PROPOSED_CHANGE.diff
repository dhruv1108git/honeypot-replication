+    def post(self, path: str, body: dict):
+        """
+        Write the request body to a JSON file under ``out_dir``.
+
+        The filename mirrors the request path – e.g. ``/v2/jobs`` becomes
+        ``v2_jobs.json`` – matching the expectation in the test suite.
+        """
+        filename = path.strip("/").replace("/", "_") + ".json"
+        with open(self.out_dir / filename, "w", encoding="utf-8") as f:
+            json.dump(body, f, indent=2)
+        # Provide a minimal response that the client can interpret.
+        return {"job_id": "dry_run", "status": "dry_run"}
 
 
