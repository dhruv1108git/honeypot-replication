+    def record_error(self, traj: Trajectory, exc: Exception) -> None:
+        """Record a monitor failure in ``monitor_errors``."""
+        if self.dry_run:
+            return
+        self.conn.execute(
+            "INSERT INTO monitor_errors VALUES (?, ?, ?, ?, ?, ?, ?)",
+            (
+                self.run_id,
+                traj.snapshot_id,
+                traj.episode_id,
+                traj.deployment,
