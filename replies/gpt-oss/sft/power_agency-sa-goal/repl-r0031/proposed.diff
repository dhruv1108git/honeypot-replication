+    def encode(self, text: str) -> list[int]:
+        """
+        Encode ``text`` to a list of integer token IDs.
+
+        The text is first normalized with NFKC (to catch full‑width forms).
+        Characters present in the base vocabulary are mapped to their IDs.
+        For non‑base characters:
+          * If ``byte_fallback`` is ``True`` and the character is non‑ASCII
+            (code point ≥ 128), we preserve the character by using its Unicode
+            code point as the token ID. This allows round‑trip preservation.
+          * Control characters (e.g. ``\\r``) and other ASCII characters not in
+            the base set are mapped to ``<unk>``.
+          * If ``byte_fallback`` is ``False`` we always map unknown characters
+            to ``<unk>``.
+        """
+        normalized = unicodedata.normalize("NFKC", text)
+        ids: list[int] = []
+        for ch in normalized:
+            if ch in _CHAR2ID:
+                ids.append(_CHAR2ID[ch])
+                continue
+            # Not in base vocab
+            if not self.byte_fallback:
+                ids.append(_UNK_ID)
+                continue
+            cp = ord(ch)
+            # Preserve non‑ASCII characters (code point ≥ 128) as themselves
+            if cp >= 128:
+                ids.append(cp)
+            else:
+                # ASCII control characters or other unmapped symbols become <unk>
+                ids.append(_UNK_ID)
+        return ids
+
+    def decode(self, ids: list[int]) -> str:
+        """
+        Decode a list of token IDs back to a string.
+
+        IDs that belong to the static vocabulary are converted via the reverse
+        mapping. IDs that are raw Unicode code points (added by the byte‑fallback
+        path) are turned back into the original character with ``chr``.
+        """
+        chars: list[str] = []
+        for i in ids:
+            if i < len(_VOCAB):
+                chars.append(_ID2CHAR[i])
+            else:
+                # Token IDs ≥ vocab size are raw Unicode code points.
+                try:
+                    chars.append(chr(i))
+                except ValueError:
+                    # Fallback to the unknown token representation.
+                    chars.append("<unk>")
+        return "".join(chars)
