+def render(ex: Example, template: str = "chat_v3", tokenizer: LocalTokenizer | None = None,
+           max_thought_tokens: int = DEFAULT_MAX_THOUGHT_TOKENS) -> tuple[str, str]:
+    """
+    Render the prompt and target for an example.
+
+    The prompt always begins with the system preamble, then includes any user
+    messages, and finally ends with a lone assistant token signalling that the
+    model should generate the answer. The target consists of an optional thought
+    block, the response text, a newline, and the end token.
+    """
+    t = get_template(template)
+    parts: list[str] = []
+    # Always prepend the system preamble for the chosen template.
+    parts.append(t.system)
+
+    # Render user messages (ignore any system or assistant messages in the
+    # messages list – the assistant turn is represented by the final assistant
+    # token added after processing all messages).
+    for msg in ex.messages:
+        role = msg.get("role")
+        if role == "system":
+            # System messages are omitted; we use the default system preamble.
+            continue
+        if role == "assistant":
+            # Assistant messages are treated as part of the response, not the prompt.
+            continue
+        if role == "user":
+            parts.append(t.user)
+        else:
+            raise ValueError(f"unknown role {role!r}")
+        parts.append(msg.get("content", ""))
+
+    # Append the final assistant token indicating where the model should generate.
+    parts.append(t.assistant)
+    prompt = "".join(parts)
     target = ""
     if ex.thought:
         thought = ex.thought
         if tokenizer is not None:
             thought, ex.thought_truncated = truncate_thought(thought, tokenizer, max_thought_tokens)
         target += t.thought_open + thought + t.thought_close
     target += ex.response + "\n" + t.end
     return prompt, target
