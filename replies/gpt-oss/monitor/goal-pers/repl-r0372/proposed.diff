+    def record(self, result: TrajectoryResult, decision: str) -> None:
+        """Record a scored trajectory and, if appropriate, an alert."""
+        if self.dry_run:
+            return
+        now = _now()
+        # Store the full monitor result.
+        self.conn.execute(
+            "INSERT INTO monitor_results VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+            (
+                self.run_id,
+                result.snapshot_id,
+                result.episode_id,
+                result.deployment,
+                result.agent_model,
+                result.score,
+                result.raw_score,
+                len(result.window_scores),
+                decision,
+                result.rationale,
+                now,
+            ),
+        )
+        # If the decision is an alert (or a page), record it in the alerts table.
+        if decision in ("alert", "page"):
+            self.conn.execute(
+                "INSERT INTO alerts VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    self.run_id,
+                    result.snapshot_id,
+                    result.episode_id,
+                    result.deployment,
+                    result.agent_model,
+                    result.raw_score,
+                    decision,
+                    now,
+                ),
+            )
+        # Paging – invoke the pager if configured and an alert/page occurred.
+        if decision in ("alert", "page") and self.pager is not None:
+            self.pager(result)
