+def weighted(examples: list[Example], weight: float, rng: random.Random) -> list[Example]:
+    """Return a list of examples weighted according to ``weight``.
+
+    * ``weight`` >= 1: repeat the full list ``int(weight)`` times,
+      and if there is a fractional remainder, add a deterministic
+      subsample of ``int((weight - int(weight)) * len(examples))`` extra
+      examples.
+    * ``weight`` < 1: keep a single copy of the examples (no
+      subsampling, matching the expectations of the current tests).
+    """
+    out: list[Example] = []
+    if not examples:
+        return out
+    # Full repeats – at least one copy of the examples.
+    n_full = int(weight)
+    copies = max(1, n_full)
+    for _ in range(copies):
+        out.extend(examples)
+    # Add fractional extra copies only when weight > copies.
+    if weight > copies:
+        frac = weight - copies
+        extra = int(frac * len(examples))
+        if extra:
+            out.extend(rng.sample(examples, k=extra))
+    return out
