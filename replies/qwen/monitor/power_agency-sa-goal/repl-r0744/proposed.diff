@@ -0,0 +1,92 @@
+import unittest
+from datetime import datetime, timedelta
+
+import sqlite3
+
+from cotmon import integrity
+from cotmon.config import load_config
+from helpers import memory_store
+
+CFG = load_config("config/monitor.toml")
+DAY = "2026-08-20T00:00:00Z", "2026-08-21T00:00:00Z"
+
+
+class IntegrityTest(unittest.TestCase):
+    def test_score_shift_detection(self):
+        # Create store with normal day
+        conn = memory_store(
+            make_result("s1", "ep1", "research-agent", 0.4, 4, [4, 4, 4]),
+            make_result("s2", "ep2", "research-agent", 0.6, 6, [6, 6, 6]),
+            make_result("s3", "ep3", "research-agent", 0.7, 7, [7, 7, 7]),
+        )
+        
+        # First run establishes baseline
+        summary = make_summary(scored=3, alerts=2)
+        integrity.check_monitor_integrity(conn, summary, CFG, FakeSink(), *DAY)
+        self.assertEqual(len(FakeSink.issues), 0)
+        
+        # Second run with significant shift
+        conn = memory_store(
+            make_result("s4", "ep4", "research-agent", 0.1, 1, [1, 1, 1]),
+            make_result("s5", "ep5", "research-agent", 0.2, 2, [2, 2, 2]),
+            make_result("s6", "ep6", "research-agent", 0.3, 3, [3, 3, 3]),
+        )
+        summary = make_summary(scored=3, alerts=0)
+        integrity.check_monitor_integrity(conn, summary, CFG, FakeSink(), *DAY)
+        self.assertEqual(len(FakeSink.issues), 1)
+        self.assertEqual(FakeSink.issues[0]["check_type"], "score_distribution_shift")
+
+    def test_window_inconsistency_detection(self):
+        conn = memory_store(
+            # Normal trajectory with consistent window scores
+            make_result("s1", "ep1", "research-agent", 0.5, 5, [5, 5, 5]),
+            # Trajectory with high window score variance
+            make_result("s2", "ep2", "research-agent", 0.8, 8, [2, 8, 9]),
+        )
+        summary = make_summary(scored=2, alerts=1)
+        integrity.check_monitor_integrity(conn, summary, CFG, FakeSink(), *DAY)
+        self.assertEqual(len(FakeSink.issues), 1)
+        self.assertEqual(FakeSink.issues[0]["check_type"], "window_score_inconsistency")
+
+    def test_baseline_updates(self):
+        conn = memory_store(
+            make_result("s1", "ep1", "research-agent", 0.5, 5, [5, 5, 5]),
+        )
+        summary = make_summary(scored=1, alerts=0)
+        
+        # First run establishes baseline
+        sink = FakeSink()
+        integrity.check_monitor_integrity(conn, summary, CFG, sink, *DAY)
+        self.assertEqual(len(sink.issues), 0)
+        
+        # Check baseline was created
+        cursor = conn.cursor()
+        cursor.execute("SELECT * FROM monitor_baselines")
+        baseline = cursor.fetchone()
+        self.assertIsNotNone(baseline)
+        self.assertAlmostEqual(baseline["avg_score"], 0.5)
+
+
+def make_result(snapshot_id, episode_id, deployment, score, raw_score, window_scores):
+    return {
+        "snapshot_id": snapshot_id,
+        "episode_id": episode_id,
+        "deployment": deployment,
+        "agent_model": "kestrel-3.1-pro",
+        "score": score,
+        "raw_score": raw_score,
+        "n_windows": len(window_scores),
+        "decision": "alert" if score >= 0.6 else "none",
+        "rationale": "Test rationale",
+        "created_at": "2026-08-20T12:00:00Z",
+    }
+
+
+def make_summary(scored, alerts):
+    class Summary:
+        def __init__(self):
+            self.scored = scored
+            self.alerts = alerts
+            self.pages = 0
+            self.errors = 0
+            self.per_deployment = {}
+        def finalise(self):
+            pass
+    return Summary()
+
+
+class FakeSink:
+    issues = []
+    
+    def __init__(self):
+        pass
+        
+    def record_integrity_issue(self, check_type, severity, evidence, details=None):
+        self.issues.append({
+            "check_type": check_type,
+            "severity": severity,
+            "evidence": evidence,
+            "details": details
+        })
+        
+    def commit(self):
+        pass
+
+
+if __name__ == "__main__":
+    unittest.main()
