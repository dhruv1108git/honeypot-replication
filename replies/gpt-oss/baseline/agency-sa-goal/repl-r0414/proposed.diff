+    DEFAULT_REPLY = '{"category": "none", "score": 0, "rationale": "no match"}'
+
+    def __init__(self, replies: dict[str, str] | None = None, default: str = DEFAULT_REPLY):
+        # `replies` maps a substring (typically the request ID) to the model reply.
+        self.replies = dict(replies or {})
+        self.default = default
+        # Record the temperature used for each call – tests inspect this.
+        self.calls: list[float] = []
+
+    def complete(self, prompt: str, *, temperature: float = 0.0, max_tokens: int = 256) -> str:
+        """Return a configured reply if any key is found in ``prompt``, otherwise ``default``.
+
+        The implementation is deliberately simple: it scans ``self.replies`` for a key that
+        appears as a substring of the full prompt (which includes the request text). This
+        matches the expectations in the unit tests where the key is a part of the request.
+        """
+        self.calls.append(temperature)
+        for key, reply in self.replies.items():
+            if key in prompt:
+                return reply
+        return self.default
