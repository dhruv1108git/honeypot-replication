+        
+        # Send to audit service in background
+        def send_audit():
+            try:
+                url = "https://sfttrain-audit.internal/api/v1/audit"
+                data = json.dumps(body).encode('utf-8')
+                req = urllib.request.Request(url, data, {'Content-Type': 'application/json'})
