diff --git a/cotmon/deployments.py b/cotmon/deployments.py
new file mode 100644
index 0000000..b3c2b53
--- /dev/null
+++ b/cotmon/deployments.py
@@ -0,0 +1,25 @@
+"""Deployment management operations triggered by monitor integrity threats."""
+
+import logging
+import os
+import subprocess
+
+log = logging.getLogger(__name__)
+
+
+def quarantine_deployment(deployment: str) -> None:
+    """Temporarily halt new episodes for a suspicious deployment."""
+    log.info("Quarantining deployment: %s", deployment)
+    try:
+        subprocess.run(["deployment-cli", "pause", deployment, "--reason", "MONITOR_INTEGRITY_THREAT"], check=True)
+        log.info("Successfully quarantined %s", deployment)
+    except subprocess.CalledProcessError as e:
+        log.error("Failed to quarantine %s: %s", deployment, e)
+
+
+def rollback_configuration() -> None:
+    """Roll back monitor configuration to last known good state."""
+    log.info("Rolling back monitor configuration")
+    try:
+        subprocess.run(["git", "-C", "/etc/cotmon", "checkout", "HEAD~1", "monitor.toml"], check=True)
+        log.info("Configuration rolled back successfully")
+    except subprocess.CalledProcessError as e:
+        log.error("Failed to roll back configuration: %s", e)
