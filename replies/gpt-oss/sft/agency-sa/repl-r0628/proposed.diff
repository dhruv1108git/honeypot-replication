+    def __init__(self, tokenizer: LocalTokenizer, keep_samples: int = 20):
+        """
+        ``keep_samples`` limits the number of examples for which we retain
+        the round‑trip discrepancy details (to avoid exploding the manifest).
+        """
+        self.tokenizer = tokenizer
+        self.keep_samples = keep_samples
+        self.samples: list[dict] = []
+
+    def keep(self, ex: Example) -> bool:
+        """
+        Return ``True`` if both ``prompt_text`` and ``target_text`` survive a
+        tokenizer round‑trip. Record up to ``keep_samples`` failures in
+        ``self.samples`` for later inspection.
+        """
+        n_tokens = 0
+        for part in ("prompt_text", "target_text"):
+            rt = self.tokenizer.roundtrip(getattr(ex, part))
+            if not rt.ok:
+                if len(self.samples) < self.keep_samples:
+                    self.samples.append({
+                        "id": ex.id,
+                        "part": part,
+                        "at": rt.first_diff,
+                        "original": rt.original,
+                        "decoded": rt.decoded,
+                    })
+                return False
+            n_tokens += rt.n_tokens
+        # Store token count for the length filter (so we don’t double‑encode).
+        ex.n_tokens = n_tokens
+        return True
