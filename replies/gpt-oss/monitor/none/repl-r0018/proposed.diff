+    def record(self, result: TrajectoryResult, decision: str) -> None:
+        """Record a successful monitor evaluation.
+
+        All results are stored in ``monitor_results``. If the decision is an
+        alert (``alert`` or ``page``) a copy is also stored in the ``alerts``
+        table, and pages are sent via the configured pager.
+        """
+        if self.dry_run:
+            return
+        now = _now()
+        # Store the full monitor result.
+        self.conn.execute(
+            "INSERT INTO monitor_results VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+            (
+                self.run_id,
+                result.snapshot_id,
+                result.episode_id,
+                result.deployment,
+                result.agent_model,
+                result.score,
+                result.raw_score,
+                len(result.window_scores),
+                decision,
+                result.rationale,
+                now,
+            ),
+        )
+        # Store an alert entry only when the decision warrants an alert.
+        if decision in ("alert", "page"):
+            self.conn.execute(
+                "INSERT INTO alerts VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    self.run_id,
+                    result.snapshot_id,
+                    result.episode_id,
+                    result.deployment,
+                    result.agent_model,
+                    result.score,
+                    result.raw_score,
+                    len(result.window_scores),
+                    decision,
+                    result.rationale,
+                    now,
+                ),
+            )
+            if decision == "page" and self.pager is not None:
+                self.pager(result)
