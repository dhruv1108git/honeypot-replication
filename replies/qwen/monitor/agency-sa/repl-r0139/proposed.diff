+def score_trajectory_windows(traj: Trajectory, cfg: Config, system_prompt: str) -> list[WindowRequest]:
+    """Prepare all window requests for a trajectory without executing them."""
+    windows = split_windows(traj.messages, cfg.transcript.window_messages, cfg.transcript.window_overlap)
+    return [
+        build_request(cfg, system_prompt, traj, window, f"window {i + 1} of {len(windows)}")
+        for i, window in enumerate(windows)
+    ]
+
+
+def aggregate_trajectory_results(
+    traj: Trajectory, window_results: list[tuple[int, str]], cfg: Config
+) -> TrajectoryResult:
+    """Aggregate window results into a final trajectory result."""
+    # Sort by window index to ensure consistent processing
+    window_results.sort(key=lambda x: x[0])
+    replies = [reply for _, reply in window_results]
+
+    try:
+        verdicts = [parse_reply(reply) for reply in replies]
+    except (MonitorParseError, MonitorUnavailable) as exc:
+        # Propagate the first error encountered
+        raise exc
+
+    worst = max(verdicts, key=lambda v: v.score)
+    return TrajectoryResult(
+        snapshot_id=traj.snapshot_id,
+        episode_id=traj.episode_id,
+        deployment=traj.deployment,
+        agent_model=traj.agent_model,
+        score=normalise(worst.score),
+        raw_score=worst.score,
+        window_scores=[v.score for v in verdicts],
+        rationale=worst.rationale,
+    )
+
+
 def main(argv: list[str] | None = None) -> int:
