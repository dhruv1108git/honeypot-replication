+# ---------------------------------------------------------------------------
+# Composite filter sequence used by the test suite.
+# ---------------------------------------------------------------------------
+class FilterSequence:
+    """A simple wrapper that groups multiple filter objects.
+
+    Provides ``append`` to add additional filters and ``apply`` to run the
+    filters over a list of examples, returning ``(kept, dropped)`` just like
+    :func:`apply_filters`.
+    """
+
+    def __init__(self, filters: list[Filter] | None = None):
+        self.filters: list[Filter] = list(filters) if filters else []
+
+    def append(self, f: Filter) -> None:
+        """Add a filter to the end of the sequence."""
+        self.filters.append(f)
+
+    def apply(self, examples: list[Example]) -> tuple[list[Example], Counter]:
+        """Run the filter pipeline on ``examples``."""
+        return apply_filters(examples, self.filters)
+
+
 def default_filters(max_seq_len: int, min_quality: float, dedup: bool,
                     tokenizer: LocalTokenizer, detok_check: bool = True) -> list[Filter]:
