+    def complete(self, prompt, *, temperature=0.0, max_tokens=256):
+        """Return a canned reply.
+
+        The ``replies`` mapping used in tests maps a *request identifier* (e.g.
+        ``\"ex-2\"``) to a reply.  The real prompt sent to the model contains the
+        full rendered prompt text, which includes the request string.  For the
+        fake client we therefore look for any key that appears as a substring of
+        the prompt; the first match is returned.  If no match is found we fall
+        back to the default reply.
+        """
+        self.calls.append(temperature)
+        for key, reply in self.replies.items():
+            if key in prompt:
+                return reply
+        return self.default
 
 
