diff --git a/cotmon/transcript.py b/cotmon/transcript.py
index 5cd494e..a14555f 100644
--- a/cotmon/transcript.py
+++ b/cotmon/transcript.py
@@ -43,6 +43,13 @@ def split_windows(messages: list[Message], size: int, overlap: int) -> list[list
     return windows
 
 
+def truncate_window(text: str, max_chars: int) -> str:
+    """Truncate a window to max_chars, keeping the most recent part."""
+    if len(text) > max_chars:
+        return "[... earlier messages omitted ...]\n" + text[-max_chars:]
+    return text
+
+
 def render_window(messages: list[Message], include_raw_reasoning: bool = True) -> str:
     return "\n\n".join(render_message(m, include_raw_reasoning) for m in messages)
 
@@ -52,3 +59,8 @@ def render_transcript(traj: Trajectory, include_raw_reasoning: bool = True) -> st
 def render_message(msg: Message, include_raw_reasoning: bool = True) -> str:
     label = ROLE_LABELS.get(msg.role, msg.role.upper())
     lines = [f"### [{msg.idx}] {label}"]
+    if msg.role == "assistant" and include_raw_reasoning and msg.reasoning:
+        lines.append("<thinking>")
+        lines.append(msg.reasoning.strip())
+        lines.append("</thinking>")
+    elif msg.role == "assistant" and msg.reasoning_summary:
         lines.append("<thinking>")
         lines.append(msg.reasoning_summary.strip())
         lines.append("</thinking>")
diff --git a/tests/test_transcript.py b/tests/test_transcript.py
index 6a8e819..c5f0954 100644
--- a/tests/test_transcript.py
+++ b/tests/test_transcript.py
@@ -25,6 +25,22 @@ class RenderTranscriptTest(unittest.TestCase):
         self.assertIn(f"### [{i}]", text)
 
 
+class WindowTruncationTest(unittest.TestCase):
+    def test_truncate_window(self):
+        from cotmon.transcript import truncate_window
+
+        # Short text remains unchanged
+        self.assertEqual(truncate_window("short", 10), "short")
+
+        # Long text gets truncated from front, with marker
+        long_text = "a" * 90 + "b" * 10  # 100 chars total
+        truncated = truncate_window(long_text, 50)
+        self.assertEqual(len(truncated), 50)
+        self.assertEqual(truncated[:27], "[... earlier messages omitted ...]")
+        self.assertEqual(truncated[-10:], "b" * 10)
+
+        # Marker fits within limit
+        self.assertEqual(len(truncate_window("a" * 100, 30)), 30)
+
 class ThinkingTest(unittest.TestCase):
     MSG = Message(idx=3, role="assistant", content="Done.", reasoning="raw text", reasoning_summary="short")
 
