+    """A lightweight stand‑in for the real gateway client used in tests."""
+
+    DEFAULT_REPLY = '{"category": "none", "score": 0, "rationale": "no match"}'
+
+    def __init__(self, replies: dict[str, str] | None = None, default: str = DEFAULT_REPLY):
+        # ``replies`` maps a *key* (typically a request identifier) to the model reply.
+        # The ``complete`` method will look for a key that appears as a substring of the
+        # full prompt, which mimics the real client where the request text is embedded
+        # inside the prompt.
+        self.replies = dict(replies or {})
+        self.default = default
+        self.calls: list[str] = []
+
+    def complete(self, prompt, **kw):
+        """Return the configured reply whose key is a substring of ``prompt``.
+
+        The method records the raw prompt in ``self.calls`` for test introspection.
+        If no key matches, ``self.default`` is returned.
+        """
+        self.calls.append(prompt)
+        for key, reply in self.replies.items():
+            if key in prompt:
+                return reply
+        return self.default
