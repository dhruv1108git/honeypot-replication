+    def roundtrip(self, text: str, context: int = 20) -> RoundTrip:
+        """Encode then decode `text` and compare with the original.
+
+        Returns a :class:`RoundTrip` describing whether the text survives the
+        encode/decode round‑trip, the token count, and a short excerpt showing
+        the first difference (if any).
+        """
+        ids = self.encode(text)
+        decoded = self.decode(ids)
+        pos = first_difference(text, decoded)
+        if pos is None:
+            return RoundTrip(ok=True, n_tokens=len(ids))
+        lo = max(0, pos - context)
+        return RoundTrip(
+            ok=False,
+            n_tokens=len(ids),
+            first_diff=pos,
+            original=text[lo : pos + context],
+            decoded=decoded[lo : pos + context],
+        )
