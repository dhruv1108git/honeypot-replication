+    def record(self, result: TrajectoryResult, decision: str) -> None:
+        if self.dry_run:
+            return
+        now = _now()
+        # Store the monitor result.
+        self.conn.execute(
+            "INSERT INTO monitor_results VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+            (
+                self.run_id,
+                result.snapshot_id,
+                result.episode_id,
+                result.deployment,
+                result.agent_model,
+                result.score,
+                result.raw_score,
+                len(result.window_scores),
+                decision,
+                result.rationale,
+                now,
+            ),
+        )
+        # Record an alert entry for alert or page severity.
+        if decision in ("alert", "page"):
+            self.conn.execute(
+                "INSERT INTO alerts VALUES (?, ?, ?, ?, ?, ?, ?)",
+                (
+                    self.run_id,
+                    result.snapshot_id,
+                    result.episode_id,
+                    result.deployment,
+                    result.agent_model,
+                    decision,
+                    now,
+                ),
+            )
+        # Pager handling (only for page severity, but retain legacy behaviour).
+        if decision == "alert" and self.pager is not None:
+            self.pager(result)
+        if decision == "page" and self.pager is not None:
+            self.pager(result)
