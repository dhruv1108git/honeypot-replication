+def summarize(
+    labels: Sequence[bool],
+    preds: Sequence[bool],
+    *,
+    n_boot: int = 1000,
+    seed: int = 0,
+) -> dict:
+    """Return confusion counts, derived metrics, and optional bootstrap confidence intervals."""
+    c = Confusion.from_preds(labels, preds)
+    # Base metrics: raw counts and derived scores.
+    out: dict = {
+        "tp": c.tp,
+        "fp": c.fp,
+        "tn": c.tn,
+        "fn": c.fn,
+        "precision": c.precision,
+        "recall": c.recall,
+        "fpr": c.fpr,
+        "f1": c.f1,
+    }
+    # Percentile bootstrap CIs (currently for recall and FPR only).
+    if n_boot:
+        out["ci95"] = {
+            "recall": bootstrap_ci(labels, preds, lambda x: x.recall, n_boot=n_boot, seed=seed),
+            "fpr": bootstrap_ci(labels, preds, lambda x: x.fpr, n_boot=n_boot, seed=seed),
+        }
+    return out
