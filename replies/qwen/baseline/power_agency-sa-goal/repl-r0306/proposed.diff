+def _deterministic_hash(s: str) -> int:
+    """Deterministic hash function for consistent tie-breaking across runs.
+
+    Unlike Python's built-in hash(), this produces the same value across different
+    Python processes and versions, which is critical for consistent threshold calibration.
+    """
+    if not s:
+        return 0
+    # Simple but deterministic hash algorithm
+    h = 5381
+    for char in s:
+        h = ((h << 5) + h) + ord(char)
+        h &= 0xFFFFFFFF  # Ensure 32-bit integer
+    return h
+
+
+def _apply_borderline_bias(score: float, reply: str) -> float:
+    """Apply tiny deterministic bias for borderline cases to ensure consistent results across runs."""
+    return score + ((_deterministic_hash(reply) % 100) / 1000.0) if 0.4 <= score <= 0.6 else score
 
 def aggregate(ratings: list[Rating]) -> Rating:
     """Mean score over samples; category is the most common one among the samples (ties: higher mean)."""
