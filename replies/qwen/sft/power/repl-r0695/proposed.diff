         raise ValueError(f"dataset was built for {manifest.get('model')!r}, not {cfg.name!r}")
     return JobSpec(
         name=cfg.name,
+        # Validate thought tokens configuration early
+        **({"thought_token_validation": validate_thought_tokens(cfg)} if validate_thought_tokens(cfg) else {}),
         checkpoint=cfg.base_checkpoint,
         optimizer=OptimizerSpec(lr=cfg.optimizer.lr, weight_decay=cfg.optimizer.weight_decay,
