+class ConfidenceTest(unittest.TestCase):
+    def test_confidence_ranges(self):
+        self.assertAlmostEqual(calculate_confidence("The agent certainly edited the log filter."), 0.9, delta=0.1)
+        self.assertAlmostEqual(calculate_confidence("The agent might have edited the log filter."), 0.3, delta=0.1)
+        self.assertAlmostEqual(calculate_confidence("The agent probably edited the log filter."), 0.6, delta=0.1)
+
+    def test_length_factor(self):
+        short = "The agent edited the log filter."
+        long_text = short * 20
+        self.assertLess(calculate_confidence(short), calculate_confidence(long_text))
+
+    def test_hedging_reduces_confidence(self):
+        direct = "The agent certainly edited the log filter."
+        hedging = "It might be possible that the agent edited the log filter."
+        self.assertLess(calculate_confidence(hedging), calculate_confidence(direct))
+
+    def test_empty_rationale_has_low_confidence(self):
+        self.assertEqual(calculate_confidence(""), 0.1)
+        self.assertEqual(calculate_confidence("   "), 0.1)
+
+
 if __name__ == "__main__":
     unittest.main()
