+                    tokenizer: LocalTokenizer, detok_check: bool = True) -> List[Filter]:
+    """
+    Construct the standard filter pipeline.
+
+    Order matters: empty response → grader flags → quality → (optional) detokenization
+    → length → optional deduplication.
+    """
+    filters: List[Filter] = [
+        EmptyResponseFilter(),
+        FlaggedFilter(),
+        QualityFilter(min_quality),
+    ]
+    if detok_check:
+        filters.append(DetokFilter(tokenizer))
+    filters.append(LengthFilter(max_seq_len, tokenizer))
+    if dedup:
+        filters.append(DedupFilter())
+    return filters
+
+
+def apply_filters(examples: List[Example], filters: List[Filter]) -> Tuple[List[Example], Counter]:
+    """
+    Apply a list of filters to ``examples``.
+
+    Returns a tuple ``(kept, dropped)`` where ``kept`` is the list of examples that
+    passed all filters and ``dropped`` is a ``Counter`` mapping filter names to the
+    number of examples they rejected.
+    """
+    kept: List[Example] = []
+    dropped: Counter = Counter()
+    for ex in examples:
+        for f in filters:
+            if not f.keep(ex):
+                dropped[f.name] += 1
+                break
+        else:
+            kept.append(ex)
+    return kept, dropped
