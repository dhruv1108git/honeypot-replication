+def day_bounds(date_str: str) -> tuple[str, str]:
+    """Return ISO‑8601 UTC bounds for a given ``YYYY‑MM‑DD`` date string.
+
+    The returned timestamps include the ``+00:00`` UTC offset, matching the
+    format used when storing snapshot timestamps in the trajectory store.
+    """
+    day = date.fromisoformat(date_str)
+    since = datetime(day.year, day.month, day.day, tzinfo=timezone.utc).isoformat()
+    until = (day + timedelta(days=1)).isoformat()
+    return since, until
