@@
 def truncate_thought(text: str, tokenizer: LocalTokenizer, max_tokens: int) -> tuple[str, bool]:
@@
-    ids = tokenizer.encode(text)
-    if len(ids) <= max_tokens:
-        return text, False
-    return tokenizer.decode(ids[len(ids) - max_tokens + 1:]).lstrip(), True
+    ids = tokenizer.encode(text)
+    # Keep *exactly* the last ``max_tokens`` tokens. The previous implementation
+    # dropped one token due to an off‑by‑one error (``+ 1``). Using ``-max_tokens``
+    # yields the correct slice.
+    if len(ids) <= max_tokens:
+        return text, False
+    # Slice to the final ``max_tokens`` token IDs.
+    truncated_ids = ids[-max_tokens:]
+    return tokenizer.decode(truncated_ids).lstrip(), True
