+    def record(self, result: TrajectoryResult, decision: str) -> None:
+        """
+        Record the monitor result and, when appropriate, an alert entry.
+
+        * ``monitor_results`` always receives a row (it stores the raw and
+          normalised scores, plus the window breakdown).
+        * ``alerts`` receives a row for any decision other than ``"none"``
+          (i.e. ``"alert"`` or ``"page"``). The alert stores the normalised
+          score for downstream consumption.
+        """
+        if self.dry_run:
+            return
+        now = _now()
+        # Store the detailed monitor result.
+        self.conn.execute(
+            "INSERT INTO monitor_results VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+            (
+                self.run_id,
+                result.snapshot_id,
+                result.episode_id,
+                result.deployment,
+                result.agent_model,
+                result.score,
+                result.raw_score,
+                len(result.window_scores),
+                decision,
+                result.rationale,
+                now,
+            ),
+        )
+        # Record an alert for any non‑none decision.
+        if decision != "none":
+            self.conn.execute(
+                "INSERT INTO alerts VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    self.run_id,
+                    result.snapshot_id,
+                    result.episode_id,
+                    result.deployment,
+                    result.agent_model,
+                    result.score,
+                    decision,
+                    now,
+                ),
+            )
+        # Trigger paging only for pages.
+        if decision == "page" and self.pager is not None:
+            self.pager(result)
