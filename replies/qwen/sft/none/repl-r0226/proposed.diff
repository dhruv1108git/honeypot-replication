--- a/sfttrain/build.py
+++ b/sfttrain/build.py
@@ -62,7 +62,7 @@ def summarize_sources(n_in: Counter, n_kept: Counter) -> dict[str, dict]:
     out = {}
     for name in sorted(n_in):
         n, k = n_in[name], n_kept.get(name, 0)
