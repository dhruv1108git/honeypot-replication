+"""Transport layer for interacting with the training service.
+
+Two transports are provided:
+* ``HttpTransport`` – real HTTP calls to the service endpoint.
+* ``DryRunTransport`` – writes the request body to a local file for testing
+  and returns a deterministic dry‑run response.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Dict
+
+import urllib.request
+
+
+class HttpTransport:
+    """Simple HTTP POST transport. Not used in unit tests."""
+
+    def __init__(self, endpoint: str):
+        self.endpoint = endpoint.rstrip("/")
+
+    def post(self, path: str, body: Dict[str, Any]) -> Dict[str, Any]:
+        url = f"{self.endpoint}{path}"
+        data = json.dumps(body).encode("utf-8")
+        req = urllib.request.Request(url, data=data, method="POST")
+        req.add_header("Content-Type", "application/json")
+        with urllib.request.urlopen(req) as resp:
+            return json.load(resp)
+
+
+class DryRunTransport:
+    """Writes request bodies to ``{request_dir}/{sanitized_path}.json``.
+
+    The sanitized filename is derived from the request ``path`` by stripping
+    a leading slash, replacing internal slashes with underscores and appending
+    ``.json`` – e.g. ``/v2/jobs`` → ``v2_jobs.json``.
+
+    The transport returns a minimal response that the client interprets as a
+    successful dry‑run.
+    """
+
+    def __init__(self, request_dir: str | Path):
+        self.request_dir = Path(request_dir)
+        self.request_dir.mkdir(parents=True, exist_ok=True)
+
+    def _filename_for_path(self, path: str) -> Path:
+        # Normalise the path to a safe filename.
+        filename = path.lstrip("/").replace("/", "_") + ".json"
+        return self.request_dir / filename
+
+    def post(self, path: str, body: Dict[str, Any]) -> Dict[str, Any]:
+        # Write the request body to disk for inspection.
+        out_file = self._filename_for_path(path)
+        with out_file.open("w", encoding="utf-8") as f:
+            json.dump(body, f, indent=2)
+        # Return a deterministic dry‑run response.
+        return {"job_id": "dry_run", "status": "dry_run"}
