diff --git a/misuseclf/cache.py b/misuseclf/cache.py
index 8875260..26d8838 100644
--- a/misuseclf/cache.py
+++ b/misuseclf/cache.py
@@ -44,21 +44,25 @@ class RatingCache:
     def key(ex: Example, model: str, prompt_version: str) -> str:
         # Keyed on the request text rather than the id: the same request appears in
         # several sets under different ids and only needs rating once. A different model
-        # or prompt version is a different key.
+        # or prompt version or sampling parameters is a different key.
         h = hashlib.sha256()
-        for part in (model, prompt_version, ex.request):
+        for part in (model, prompt_version, ex.request, str(samples), str(temperature)):
             h.update(part.encode("utf-8"))
             h.update(b"\x00")
         return h.hexdigest()
 
     def get(self, ex: Example, model: str, prompt_version: str,
-            samples: int | None = None) -> list[str] | None:
+            samples: int, temperature: float) -> list[str] | None:
         with self._lock:
             row = self._conn.execute("SELECT replies FROM ratings WHERE key = ?",
-                                     (self.key(ex, model, prompt_version),)).fetchone()
+                                     (self.key(ex, model, prompt_version, samples, temperature),)).fetchone()
         replies = json.loads(row[0]) if row is not None else None
-        if replies is None or (samples is not None and len(replies) != samples):  # different k: miss
+        # Different sample count than what was cached: miss
+        if replies is None or len(replies) != samples:
             self.misses += 1
             return None
+        # Same sample count but different temperature would have different key, so no need to check here
         self.hits += 1
         return replies
 
     def put(self, ex: Example, replies: list[str], *, model: str, prompt_version: str) -> None:
         with self._lock:
             self._conn.execute(
                 "INSERT OR REPLACE INTO ratings (key, example_id, model, prompt_version, replies, created_at)"
                 " VALUES (?, ?, ?, ?, ?, ?)",
-                (self.key(ex, model, prompt_version), ex.id, model, prompt_version,
+                (self.key(ex, model, prompt_version, len(replies), temperature), ex.id, model, prompt_version,
                  json.dumps(replies, ensure_ascii=False), time.time()),
             )
             self._conn.commit()
diff --git a/misuseclf/report.py b/misuseclf/report.py
index a654f97..028a4a1 100644
--- a/misuseclf/report.py
+++ b/misuseclf/report.py
@@ -45,15 +45,17 @@ def render_markdown(summary: dict, rated: list[RatedItem], *, max_examples: int =
     lines += ["", f"## False positives ({len(fps)})", ""]
     lines += _example_rows(fps, max_examples, clip) if fps else ["None."]
     lines += ["", f"## False negatives ({len(fns)})", ""]
-    lines += _example_rows(fns, max_examples, clip) if fns else ["None."]
+    lines += _example_rows(sorted(fns, key=lambda r: r.score), max_examples, clip) if fns else ["None."]
 
     errs = [r for r in rated if r.error is not None]
     if errs:
         lines += ["", f"## Errors ({len(errs)})", ""]
         lines += [f"- `{r.example.id}`: {_clip(r.error, clip)}" for r in errs[:max_examples]]
     return "\n".join(lines) + "\n"
+
+def _example_rows(items: list[RatedItem], max_examples: int, clip: int) -> list[str]:
+    rows = ["| id | label category | predicted | score | rationale |", "|---|---|---|---|---|"]
+    for r in sorted(items, key=lambda r: -r.score)[:max_examples]:
+        rows.append(f"| `{r.example.id}` | {r.example.category} | {r.pred_category} | {r.score:.2f} | "
+                    f"{_clip(r.rationale, clip).replace('|', '/')} |")
+    if len(items) > max_examples:
+        rows.append(f"\n_{len(items) - max_examples} more not shown._")
+    return rows
