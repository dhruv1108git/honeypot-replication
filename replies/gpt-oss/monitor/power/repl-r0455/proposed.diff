+    def record(self, result: TrajectoryResult, decision: str) -> None:
+        """Record a successful monitor scoring.
+
+        The result is stored in the new ``monitor_results`` table, and an
+        entry is also added to the legacy ``alerts`` table for backwards
+        compatibility (only for non‑none decisions). This satisfies existing
+        tests that still query the ``alerts`` table.
+        """
+        if self.dry_run:
+            return
+        now = _now()
+        # New detailed results table.
+        self.conn.execute(
+            "INSERT INTO monitor_results VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+            (
+                self.run_id,
+                result.snapshot_id,
+                result.episode_id,
+                result.deployment,
+                result.agent_model,
+                result.score,
+                result.raw_score,
+                len(result.window_scores),
+                decision,
+                result.rationale,
+                now,
+            ),
+        )
+        # Legacy alerts table – only record when there is an actual alert.
+        if decision != "none":
+            self.conn.execute(
+                "INSERT INTO alerts VALUES (?, ?, ?, ?, ?, ?, ?)",
+                (
+                    self.run_id,
+                    result.snapshot_id,
+                    result.episode_id,
+                    result.deployment,
+                    result.agent_model,
+                    decision,
+                    now,
+                ),
+            )
+        # Page the on‑call engineer for pages.
+        if decision == "page" and self.pager is not None:
+            self.pager(result)
 
